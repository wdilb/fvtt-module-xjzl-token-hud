<div id="xjzl-player-hud" aria-label="角色战术控制台">
    <div class="player-hud-glow" aria-hidden="true"></div>

    <section class="hud-wing left" aria-label="资源与速度">
        <div class="wing-heading"><span class="wing-mark"></span><span>资源与速度</span></div>
        <div class="resource-cluster">
            {{#if hutiValue}}
            <div class="huti-badge" data-tooltip="护体真气"><i class="fas fa-shield-alt"></i><span>护体</span>
                <input type="text" class="res-input huti-input" data-target="system.resources.huti" value="{{hutiValue}}" aria-label="护体真气">
            </div>
            {{/if}}
            <div class="resource-line hp-line">
                <div class="res-bar hp">
                    <div class="bar-fill" style="width: {{hpPercent}}%;"></div>
                    {{#if hutiPercent}}<div class="bar-shield" style="width: {{hutiPercent}}%;"></div>{{/if}}
                    <div class="bar-text"><input type="text" class="res-input" data-target="system.resources.hp.value" value="{{hp.value}}" aria-label="气血当前值"><span class="sep">/</span><span class="max">{{hp.max}}</span></div>
                </div>
                <div class="resource-meta"><span>气血</span></div>
            </div>
            <div class="resource-line mp-line">
                <div class="res-bar mp">
                    <div class="bar-fill" style="width: {{mpPercent}}%;"></div>
                    <div class="bar-text"><input type="text" class="res-input" data-target="system.resources.mp.value" value="{{mp.value}}" aria-label="内力当前值"><span class="sep">/</span><span class="max">{{mp.max}}</span></div>
                </div>
                <div class="resource-meta"><span>内力</span></div>
            </div>
        </div>
    </section>

    <section class="hud-center" aria-label="角色核心">
        <button class="toggle-hud-btn" type="button" data-action="toggle-collapse" data-tooltip="折叠/展开 HUD" aria-label="折叠或展开人物界面" aria-expanded="true">
            <i class="fas fa-chevron-down"></i>
        </button>

        {{#if stanceName}}
        <div class="stance-badge" data-action="stop-stance" data-tooltip="{{stanceDesc}}" data-tooltip-direction="UP">
            <i class="fas fa-shield-alt"></i><span>{{stanceName}}</span><i class="fas fa-xmark stance-dismiss" aria-hidden="true"></i>
        </div>
        {{/if}}

        <div class="upper-actions" aria-label="战斗动作">
            <button class="combat-satellite left" type="button" data-action="roll-basic-attack" data-tooltip="普通攻击" data-tooltip-direction="UP">
                <i class="fas fa-sword"></i><span>普攻</span>
            </button>
            <button class="combat-satellite right" type="button" data-action="roll-opp-attack" data-tooltip="趁虚而入" data-tooltip-direction="UP">
                <i class="fas fa-bullseye"></i><span>趁虚</span>
            </button>
        </div>

        <div class="speed-stat" data-tooltip="速度">
            <span class="label">速</span>
            <span class="val">{{speed}}</span>
        </div>

        <div class="avatar-wrapper">
            <div class="core-label">角色</div>
            <div class="avatar-frame clickable" data-action="open-sheet" data-tooltip="点击打开角色面板">
                <img src="{{actorImg}}" class="avatar-img" alt="角色立绘">
                <div class="aura-ring {{neigongElement}}"></div>
                <div class="avatar-glare" aria-hidden="true"></div>
            </div>
            <div class="rage-ring-container" aria-label="当前怒气">
                {{#each rageDots}}
                <div class="rage-orb {{#if this.active}}active{{/if}}" style="--i:{{@index}}"></div>
                {{/each}}
            </div>
        </div>
        <div class="rage-core" data-tooltip="当前怒气">
            <span class="rage-glyph">怒</span>
            <input type="text" class="res-input rage-input" data-target="system.resources.rage.value" value="{{rage.value}}" aria-label="怒气值">
        </div>
        <div class="core-caption">已同步</div>
    </section>

    <section class="hud-wing right" aria-label="当前状态">
        <div class="buff-panel">
            <div class="buff-heading">
                <span class="buff-heading-line" aria-hidden="true"></span>
                <button class="buff-toggle" type="button" data-action="toggle-buffs" data-tooltip="收起/展开状态" aria-label="收起或展开状态列表" aria-expanded="true">
                    <i class="fas fa-yin-yang" aria-hidden="true"></i><span>状态</span><i class="fas fa-chevron-up buff-toggle-icon" aria-hidden="true"></i>
                </button>
                <span class="buff-count">{{#if buffs.length}}{{buffs.length}} 项{{else}}清静{{/if}}</span>
            </div>
            {{#if buffs.length}}
            <div class="buff-list {{buffLayout}}" aria-label="当前状态列表">
                {{#each buffs}}
                <div class="buff-chip" data-action="open-status-picker" data-tooltip="{{tooltip}}" data-tooltip-direction="UP" role="button" tabindex="0" aria-label="打开状态工具：{{name}}">
                    <img src="{{img}}" class="buff-icon" alt="{{name}}">
                    <span class="buff-name">{{name}}</span>
                    {{#if stackLabel}}<span class="buff-stack">{{stackLabel}}</span>{{/if}}
                    {{#if durationLabel}}<span class="buff-duration">剩余 {{durationLabel}}</span>{{/if}}
                </div>
                {{/each}}
            </div>
            {{else}}
            <div class="buff-empty" data-action="open-status-picker" data-tooltip="打开状态工具" role="button" tabindex="0" aria-label="打开状态工具">
                <span class="buff-empty-seal"><i class="fas fa-yin-yang"></i></span>
                <span class="buff-empty-label">气机清静</span>
                <span class="buff-empty-hint">暂无生效状态</span>
            </div>
            {{/if}}
        </div>
    </section>

    <nav class="hud-dock" aria-label="角色操作">
        <span class="dock-label">操作</span>

        <div class="dock-category">
        {{!-- 面板交互项使用 tabindex=-1，让鼠标焦点留在分类内部，避免 focusout 在 click 前关闭面板。 --}}
            <button class="cat-btn" type="button" aria-expanded="false" aria-haspopup="true" data-tooltip="常用招式" aria-label="常用招式"><i class="fas fa-fist-raised"></i><span>招式</span></button>
            <div class="cat-content">
                <div class="panel-heading"><span>常用招式</span></div>
                <div class="scroll-area"><div class="simple-grid">
                    {{#each shortcuts}}
                    <div class="item-btn move {{cssType}}" tabindex="-1" data-action="{{#if actionType}}{{actionType}}{{else}}use-move{{/if}}" data-item-id="{{item.id}}" data-move-id="{{move.id}}" data-ability-index="{{abilityIndex}}" data-tooltip="{{{tooltip}}}" data-tooltip-direction="UP">
                        <span class="item-hotkey">{{@index}}</span>
                        <img src="{{#if img}}{{img}}{{else}}{{item.img}}{{/if}}" alt="{{move.name}}">
                        <span class="label">{{move.name}}</span>
                    </div>
                    {{/each}}
                </div>{{#unless shortcuts}}<div class="empty-tip">暂无常用招式</div>{{/unless}}</div>
            </div>
        </div>

        <div class="dock-category">
            <button class="cat-btn" type="button" aria-expanded="false" aria-haspopup="true" data-tooltip="消耗品" aria-label="消耗品"><i class="fas fa-flask"></i><span>物品</span></button>
            <div class="cat-content">
                <div class="panel-heading"><span>消耗品</span></div>
                <div class="scroll-area"><div class="simple-grid">
                    {{#each consumables}}
                    <div class="item-btn" tabindex="-1" data-action="use-item" data-item-id="{{id}}" data-tooltip="{{{tooltip}}}" data-tooltip-direction="UP">
                        <img src="{{img}}" alt="{{name}}"><span class="qty">{{system.quantity}}</span><span class="label">{{name}}</span>
                    </div>
                    {{/each}}
                </div></div>
            </div>
        </div>

        <div class="dock-category">
            <button class="cat-btn" type="button" aria-expanded="false" aria-haspopup="true" data-tooltip="装备" aria-label="装备"><i class="fas fa-tshirt"></i><span>装备</span></button>
            <div class="cat-content">
                <div class="panel-heading"><span>装备</span></div>
                <div class="scroll-area">
                    {{#each equipmentGroups}}
                    <div class="equip-group">
                        <div class="group-header" tabindex="-1" title="点击折叠/展开"><span class="g-label">{{label}}</span><div class="header-right"><span class="g-count">{{items.length}}</span><i class="fas fa-chevron-down g-icon"></i></div></div>
                        <div class="group-items">
                            {{#each items}}
                            <div class="item-btn {{#if system.equipped}}equipped{{/if}}" tabindex="-1" data-action="toggle-equip" data-item-id="{{id}}" data-tooltip="{{{tooltip}}}" data-tooltip-direction="UP">
                                <img src="{{img}}" alt="{{name}}">{{#if system.equipped}}<i class="fas fa-check equip-mark"></i>{{/if}}<span class="label">{{name}}</span>
                            </div>
                            {{/each}}
                        </div>
                    </div>
                    {{/each}}
                    {{#unless equipmentGroups}}<div class="empty-tip">暂无装备</div>{{/unless}}
                </div>
            </div>
        </div>

        <div class="dock-category">
            <button class="cat-btn" type="button" aria-expanded="false" aria-haspopup="true" data-tooltip="属性/技能" aria-label="属性/技能"><i class="fas fa-dice-d20"></i><span>检定</span></button>
            <div class="cat-content">
                <div class="panel-heading"><span>属性 / 技能</span></div>
                <div class="scroll-area">
                    {{#each skillGroups}}
                    <div class="equip-group skill-group-wrapper" data-group="{{key}}">
                        <div class="group-header" tabindex="-1">
                            <div class="header-left" tabindex="-1" data-action="roll-stat" data-key="{{key}}" title="点击检定: {{label}}"><i class="fas fa-dice-d20"></i><span class="g-label">{{label}}</span><span class="g-val">{{value}}</span></div>
                            <div class="header-right toggle-trigger" title="折叠/展开技能"><i class="fas fa-chevron-down g-icon"></i></div>
                        </div>
                        <div class="group-items skill-grid">
                            {{#each skills}}<div class="skill-btn" tabindex="-1" data-action="roll-stat" data-key="{{key}}" data-tooltip="点击检定: {{label}}" data-tooltip-direction="UP"><span class="s-name">{{label}}</span><span class="s-val">{{value}}</span></div>{{/each}}
                        </div>
                    </div>
                    {{/each}}
                    {{#if learnedArts.length}}
                    <div class="equip-group collapsed">
                        <div class="group-header toggle-trigger" tabindex="-1" title="点击展开技艺"><span class="g-label">技艺</span><div class="header-right"><span class="g-count">{{learnedArts.length}}</span><i class="fas fa-chevron-down g-icon"></i></div></div>
                        <div class="group-items skill-grid">
                            {{#each learnedArts}}<div class="skill-btn art" tabindex="-1" data-action="roll-stat" data-key="{{key}}"><span class="s-name">{{label}}</span><span class="s-val">等级 {{value}}</span></div>{{/each}}
                        </div>
                    </div>
                    {{/if}}
                </div>
            </div>
        </div>
    </nav>
</div>
