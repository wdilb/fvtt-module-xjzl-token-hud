<div class="hud-card {{type}}" id="hud-token-{{id}}" data-token-id="{{id}}">
    <div class="hud-card-signal" aria-hidden="true">
        <span class="signal-dot"></span>
        <span>{{#if isEnemy}}敌方{{else}}友方{{/if}}</span>
    </div>

    <div class="hud-avatar-container">
        {{#if isVideo}}
        <video class="hud-avatar" src="{{img}}" autoplay loop muted playsinline></video>
        {{else}}
        <img class="hud-avatar" src="{{img}}" alt="{{name}}">
        {{/if}}
        <div class="avatar-glass" aria-hidden="true"></div>
        <div class="avatar-corner avatar-corner-a" aria-hidden="true"></div>
        <div class="avatar-corner avatar-corner-b" aria-hidden="true"></div>
    </div>

    <div class="hud-info">
        <div class="hud-header">
            <div class="hud-name">{{name}}</div>
            <span class="hud-state {{statusColorClass}}">{{statusLabel}}</span>
        </div>

        <div class="hp-track bar-track {{#unless showExactHp}}obscured{{/unless}}">
            <div class="hp-ghost bar-ghost" style="width: {{hpPercent}}%"></div>
            <div class="hp-bar bar-fill" style="width: {{hpPercent}}%"></div>
            <div class="bar-caption">气血</div>
            <div class="bar-text hp-text-overlay" aria-label="气血">
                {{#if showExactHp}}
                <span class="current-val">{{hpValue}}</span><span class="sep">/</span><span class="max-val">{{hpMax}}</span>
                {{else}}
                <span class="status-label {{statusColorClass}}">{{statusLabel}}</span>
                {{/if}}
            </div>
        </div>

        {{#if hasNeili}}
        <div class="neili-track bar-track {{#unless showExactHp}}obscured{{/unless}}">
            <div class="neili-ghost bar-ghost" style="width: {{neiliPercent}}%"></div>
            <div class="neili-bar bar-fill" style="width: {{neiliPercent}}%"></div>
            <div class="bar-caption">内力</div>
            <div class="bar-text neili-text-overlay" aria-label="内力">
                {{#if showExactHp}}
                <span class="current-val">{{neiliValue}}</span><span class="sep">/</span><span class="max-val">{{neiliMax}}</span>
                {{else}}
                <span class="status-unknown">未知</span>
                {{/if}}
            </div>
        </div>
        {{/if}}

        {{#if hasRage}}
        <div class="rage-track" aria-label="怒气">
            <span class="rage-label">怒气</span>
            {{#each rageDots}}
            <div class="rage-segment {{#if this.active}}active{{/if}}"></div>
            {{/each}}
            <span class="rage-value">{{rageValue}}</span>
        </div>
        {{/if}}
    </div>

    <div class="ultimate-overlay">
        <video class="ultimate-video" data-src="modules/xjzl-token-hud/resource/effect.webm" muted></video>
        {{#if isVideo}}
        <video class="ultimate-img" src="{{actorImg}}" autoplay loop muted playsinline></video>
        {{else}}
        <img class="ultimate-img" src="{{actorImg}}">
        {{/if}}
    </div>
</div>
